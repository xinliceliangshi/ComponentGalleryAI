PORT=3002
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini

# DeepSeek（未设置 LLM_PROVIDER 时，配置了 DEEPSEEK_API_KEY 会优先 DeepSeek）
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your_deepseek_key
# DEEPSEEK_MODEL=deepseek-chat

# 官方地址被墙 / 需走企业代理时：
# 1) OpenAI 兼容中转（由供应商提供，多为 https://xxx/v1），与官方 SDK 的 base URL 一致
# OPENAI_BASE_URL=https://api.openai.com/v1
# 2) HTTP(S) 代理（本机 Clash/V2 等本地端口示例）
# HTTPS_PROXY=http://127.0.0.1:7890

# 组件知识库数据源（可指向外部项目生成目录/文件）
# 1) legacy（默认）：目录里包含 tool-cards.json / component-chunks.jsonl
# COMPONENT_GALLERY_AI_DATA_DIR=/abs/path/to/component-gallery-ai
#
# 2) search_json：直接读取 components.search.json
# COMPONENT_GALLERY_AI_COMPONENTS_SEARCH_JSON=/abs/path/to/components.search.json
#
# 3) raw（仅用于你自己的脚本/调试，服务端暂不直接使用 raw）
# COMPONENT_GALLERY_AI_COMPONENTS_RAW_JSON=/abs/path/to/components.raw.json
#
# 模式：legacy | search_json | hybrid
# COMPONENT_GALLERY_AI_KNOWLEDGE_MODE=legacy
