# 10 轮召回测试样例（TopN：组件卡片命中）
# 一行一个 JSON：{ "query": "...", "expectIds": ["..."] }

{"query":"预约单管理列表页：主表支持列排序、表尾合计、分页，编号列可点击跳详情","expectIds":["ZhTable","ZhDiyDataTable"]}
{"query":"列表筛选区要有下单时间日期范围选择（起止时间）","expectIds":["ZhDatePicker"]}
{"query":"查询按钮主色蓝并带搜索图标，旁边一个重置按钮","expectIds":["ZhButton","ZhButtonGroup"]}
{"query":"筛选项：预约单编号输入框、关联合同（名称或编号模糊）","expectIds":["ZhInput"]}
{"query":"请求状态字段做下拉选择：待审核/已审核/已取消","expectIds":["ZhCascaderLoadMore"]}
{"query":"顶部 KPI 两张统计卡片：有效预约单蓝色强调 + 已取消预约单，圆角阴影","expectIds":["ZhPageHeadPanel","ZhBaseInfo"]}
{"query":"详情页基础信息区域：用栅格排列多个字段（类似 label/value）","expectIds":["ZhBaseInfo","ZhBaseItem"]}
{"query":"金额输入：只允许输入金额格式并自动格式化","expectIds":["ZhMoneyInput"]}
{"query":"数字输入：吨数支持两位小数、可步进增减","expectIds":["ZhInputNumber"]}
{"query":"需要一个确认弹窗：提示信息 + 确认/取消按钮","expectIds":["ZhMessageBox"]}

